<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".ui.DiagnosticActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GeXRture Diagnostics"
            android:textColor="#E0E0E0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="M1 — Hardware diagnostic APK"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Device Info Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device Info"
            android:textColor="#BB86FC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            tools:text="Model: Samsung SM-S938B..." />

        <!-- USB Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USB Glasses"
            android:textColor="#BB86FC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvUsbStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:text="⚪ Not scanned yet" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanUsb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Scan USB Devices"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp" />

        <!-- Display Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Displays"
            android:textColor="#BB86FC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDisplayInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            tools:text="Display 0: Built-in..." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshDisplays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖥️ Refresh Displays"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp" />

        <!-- Sensor Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor Reader (⚠️ UNVERIFIED)"
            android:textColor="#CF6679"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Passive: sends nothing, claims every interface and logs raw bytes. Use it to observe; the stream normally needs the handshake below."
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSensorStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:text="Idle — connect to glasses first" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartSensor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ Start"
                android:textAllCaps="false"
                android:enabled="false"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopSensor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏹ Stop"
                android:textAllCaps="false"
                android:enabled="false"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Handshake + IMU Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Handshake + IMU (⚠️ writes to glasses MCU)"
            android:textColor="#CF6679"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sends the upstream-documented XBX bootstrap + 100 ms heartbeat (xrealInterfaceLibrary, MIT), then reads IMU reports. Not yet validated on this device. Stop the raw reader first. Values shown are real device data; units unconfirmed."
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvImuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:text="Not started" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartImu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ Handshake + IMU"
                android:textAllCaps="false"
                android:enabled="false"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZeroImu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="◎ Zero"
                android:textAllCaps="false"
                android:enabled="false"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopImu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏹ Stop"
                android:textAllCaps="false"
                android:enabled="false"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Log Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diagnostic Log"
            android:textColor="#BB86FC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#0D0D0D"
            android:padding="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvLogOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#88CC88"
                android:textSize="10sp"
                android:textIsSelectable="true" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📤 Export Log"
                android:textAllCaps="false"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗑️ Clear"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
